{
  "expo": {
    "name": "QRVerse",
    "slug": "qrverse",
    "scheme: qrverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": ["android.permission.BLUETOOTH_ADVERTISE", "android.permission.BLUETOOTH_CONNECT", "android.permission.BLUETOOTH_SCAN", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION", "android.permission.NEARBY_WIFI_DEVICES"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow qrverse to scan QR codes.",
          "microphonePermission": false
        }
      ],
      ["expo-image-picker", { "photosPermission": "Allow qrverse to choose an image for translation.", "cameraPermission": "Allow qrverse to capture text for translation.", "microphonePermission": false }],
      ["expo-media-library", { "photosPermission": "Allow qrverse to save your QR images to your photo library.", "savePhotosPermission": "Allow qrverse to save QR images to your photo library.", "granularPermissions": ["photo"] }],
      ["expo-mlkit-ocr", { "iosEngine": "auto" }],
      ["expo-build-properties", { "ios": { "deploymentTarget": "16.4", "useFrameworks": "static" } }],
      ["expo-nearby-connections", { "bonjourServicesName": "qrverse", "localNetworkUsagePermissionText": "qrverse uses your local network to send files to nearby devices.", "bluetoothUsagePermissionText": "qrverse uses Bluetooth to find and connect to nearby devices." }],
      "expo-web-browser",
        "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "552f0665-e30d-4f11-9ea9-97bc22a22809"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/552f0665-e30d-4f11-9ea9-97bc22a22809"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner: akshaycyber006",
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}
